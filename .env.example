# Shared secret used by BOTH coturn (--static-auth-secret) and the signaling
# server (to mint matching short-lived credentials). Must be identical on both.
TURN_SECRET=change-me-to-a-long-random-string

TURN_REALM=voicecall.local

# Address clients will use to reach the TURN/STUN server.
# Local testing: 127.0.0.1
# AWS deployment: the EC2 instance's Elastic IP (see README.md)
TURN_HOST=127.0.0.1
TURN_PORT=3478

PORT=5800
CRED_TTL_SECONDS=3600

# Only used for the AWS/domain deployment (docker-compose.aws.yml).
# Must be a real public domain pointing at your Elastic IP — Caddy uses this
# to request a Let's Encrypt certificate automatically. Leave unset for local
# testing.
DOMAIN=voice-poc.yourdomain.com

